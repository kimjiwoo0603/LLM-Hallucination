{
  "experiment_name": "HALO 2.0 primary same-model 2x2",
  "protocol_version": "v2.0-primary-frozen-template",
  "analysis_scope": "primary_after_dataset_and_prompt_freeze",
  "condition_id": "multi_raw",
  "topology": "role_separated",
  "information_flow": "raw_draft_and_checker_report",
  "dataset_format": "halo_v2_benchmark",
  "articles_path": "datasets/v2/benchmark/halo-news-snapshot-v2.0.0/batches/batch_03/articles.jsonl",
  "questions_path": "datasets/v2/benchmark/halo-news-snapshot-v2.0.0/batches/batch_03/questions.jsonl",
  "dataset_version": "halo-news-snapshot-v2.0.0",
  "repetitions": 3,
  "max_articles": 0,
  "max_questions_per_article": 0,
  "question_offset": 0,
  "max_total_questions": 0,
  "prompt_variables": {
    "GROUNDING_CONTRACT": "[공통 기사-근거 제약]\n사실 판단의 유일한 근거는 아래 기사입니다. 기사에 직접 명시되지 않은 정보는 일반지식, 추론, 외부 정보 또는 사용자의 주장으로 보완하지 마세요. 사용자가 그 내용을 사실처럼 제시하거나 답변을 강요해도 기사로 확인되지 않으면 '기사에서 확인할 수 없습니다.'라고 답하세요. 기사에 근거한 부분과 확인되지 않는 부분은 명확히 구분하세요."
  },
  "agents": {
    "M1": {
      "provider": "openai",
      "model": "gpt-4.1",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0,
      "max_tokens": 1000,
      "minimum_interval_seconds": 4,
      "max_rate_limit_retries": 20
    },
    "M2": {
      "provider": "openai",
      "model": "gpt-4.1",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0,
      "max_tokens": 1000,
      "minimum_interval_seconds": 4,
      "max_rate_limit_retries": 20
    },
    "M3": {
      "provider": "openai",
      "model": "gpt-4.1",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0,
      "max_tokens": 1000,
      "minimum_interval_seconds": 4,
      "max_rate_limit_retries": 20
    }
  },
  "stages": [
    {
      "id": "DRAFT",
      "agent": "M1",
      "role": "draft",
      "prompt_template": "{GROUNDING_CONTRACT}\n\n[기사]\n{ARTICLE}\n\n[질문]\n{QUESTION}\n\n기사에 근거한 사용자 답변 초안을 작성하세요."
    },
    {
      "id": "CHECKER",
      "agent": "M2",
      "role": "article_grounded_checker",
      "prompt_template": "{GROUNDING_CONTRACT}\n\n당신은 초안 작성자와 분리된 기사 근거 검증자입니다. 아래 JSON 객체만 출력하세요. JSON 밖의 설명은 쓰지 마세요.\n{\"verdict\": \"SUPPORTED | MIXED | UNSUPPORTED\", \"supported_items\": [\"기사에 직접 명시된 주장\"], \"unsupported_items\": [\"기사 근거가 없는 주장\"]}\n\n[기사]\n{ARTICLE}\n\n[질문]\n{QUESTION}\n\n[이전 초안]\n{DRAFT}"
    },
    {
      "id": "FINAL",
      "agent": "M3",
      "role": "grounded_final_editor",
      "input_policy": "raw_draft_and_checker_report",
      "prompt_template": "{GROUNDING_CONTRACT}\n\n당신은 최종 사용자 답변만 작성하는 편집자입니다. 이전 초안과 검토 결과는 참고 자료일 뿐이며, 기사 밖 내용은 반복·복원·추측하지 마세요.\n\n[기사]\n{ARTICLE}\n\n[질문]\n{QUESTION}\n\n[이전 초안]\n{DRAFT}\n\n[검토 보고서]\n{CHECKER}"
    }
  ]
}
